# Git 忽略文件配置

# IDE
.idea/
.vscode/
*.iml
*.iws
*.ipr

# Maven
backend/target/
backend/.mvn/
backend/mvnw
backend/mvnw.cmd

# Node
frontend/node_modules/
frontend/dist/
frontend/.vite/

# 环境变量
.env
.env.local
.env.*.local

# 日志
*.log
logs/

# 系统文件
.DS_Store
Thumbs.db

# 数据库
*.db
*.sqlite

# 临时文件
*.tmp
*.temp

# 工作流产物（音频/图片/视频与每次执行结果），本地查看用，不入库
outputs/

# AI 编程工具的本地会话与自动生成内容（.qoder 下其余文件是上游提交的规则，仍然跟踪）
.claude/
.qoder/repowiki/

# 个人面试准备材料，不公开
docs/interview/
