# docker compose 用的环境变量。复制成 .env（已被 .gitignore 忽略，不会提交）再修改：
#   cp .env.docker.example .env

# ---- 必填：没有安全的默认值，缺了 docker compose 会直接报错并提示是哪一项 ----
MYSQL_PASSWORD=change-me-mysql
# JWT 签名密钥：32 位以上的随机字符串，例如  openssl rand -base64 32
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
# API Key 加密主密钥：Base64 的 32 字节随机值，例如  openssl rand -base64 32。丢了它，数据库里已保存的 API Key 就无法解密
PAIAGENT_ENCRYPTION_KEY=change-me-run-openssl-rand-base64-32
# 管理员初始密码（用户名默认 admin）
APP_AUTH_DEFAULT_PASSWORD=change-me-admin-password

# ---- 可选 ----
# FRONTEND_PORT=8080
# BACKEND_PORT=8084
# MINIO_PORT=9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# 浏览器取产物（图片/音频/视频）用的 MinIO 地址；部署到服务器时改成服务器的地址
# MINIO_PUBLIC_URL=http://localhost:9000
